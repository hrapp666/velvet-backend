# Velvet 后端 · 生产环境变量模板
# 用法：cp .env.example .env  → 改完真实值 → docker compose up -d
# ⚠️ .env 不进 git（已在 .gitignore）

# ── 数据库（AWS RDS MySQL 8.4.7）───────────────────────────────
DB_URL=jdbc:mysql://your-rds-endpoint:3306/velvet?useSSL=true&requireSSL=true&verifyServerCertificate=true&trustCertificateKeyStoreUrl=file:///global-bundle.pem&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USER=admin
DB_PASS=

# ── Redis（ElastiCache Serverless · 注意 host 不要带端口）──────
REDIS_HOST=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASS=

# ── JWT（256bit 随机串 · openssl rand -base64 32）────────────────
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── S3 / 对象存储（AWS S3 ap-east-1）────────────────────────────
S3_ENDPOINT=https://s3.ap-east-1.amazonaws.com
S3_ENDPOINT_PUBLIC=
S3_BUCKET=
S3_REGION=ap-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false
CDN_BASE_URL=

# ── Kafka（AWS MSK Serverless · IAM 认证）─────────────────────────
KAFKA_SERVERS=your-msk-bootstrap.kafka-serverless.ap-east-1.amazonaws.com:9098
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=AWS_MSK_IAM
KAFKA_SASL_JAAS_CONFIG=software.amazon.msk.auth.iam.IAMLoginModule required;
KAFKA_SASL_CALLBACK=software.amazon.msk.auth.iam.IAMClientCallbackHandler

# ── 支付回调基址 ─────────────────────────────────────────────
PAYMENT_NOTIFY_BASE_URL=https://agent.ylctkx9s.work
PAYMENT_DEFAULT_PROVIDER=APPLE_IAP
PAYMENT_COMMISSION_RATE=0.06
VELVET_PAYMENT_MOCK_ENABLED=false

# ── 微信支付（如启用）────────────────────────────────────────
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_KEY=

# ── 支付宝（如启用）──────────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=

# ── Apple IAP（iOS 上架前必填 · App Store Connect 取）──────────
APPLE_IAP_BUNDLE_ID=com.hrapp.velvet
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_P8_PATH=/etc/velvet/apple_iap.p8
APPLE_IAP_ENVIRONMENT=sandbox

# ── Apple Sign-In（iOS 登录）─────────────────────────────────
APPLE_BUNDLE_ID=com.hrapp.velvet
APPLE_VERIFY_AUDIENCE=true

# ── CORS（生产 false · 不允许 localhost）──────────────────────
VELVET_CORS_ALLOW_LOCALHOST=false
VELVET_CORS_EXTRA=

# ── 管理员（逗号分隔 username 或 user id）─────────────────────
ADMIN_USERNAMES=huangji,admin,root
ADMIN_USER_IDS=1

# ── 应用端口（docker-compose 已映射到 80/443）────────────────
PORT=8080
